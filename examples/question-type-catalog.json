{
  "title": "Question Type Catalog",
  "heading": "Intake-Form Question Types",
  "subhead": "All primitive types — rendered in the default theme.",
  "exportTitle": "CATALOG EXPORT",
  "sections": [
    {
      "name": "radio",
      "questions": [
        {
          "id": "radio_demo",
          "type": "radio",
          "label": "Which option best describes your situation?",
          "hint": "Pick the closest match — use commentary to qualify.",
          "required": true,
          "inferenceBox": "This is an inferenceBox: what the AI already sees about your situation.",
          "options": [
            {
              "value": "a",
              "label": "Option A",
              "description": "A clear first choice with a description.",
              "badge": "Likely match — based on prior context"
            },
            {
              "value": "b",
              "label": "Option B",
              "description": "A second choice with a description."
            },
            {
              "value": "c",
              "label": "Option C",
              "description": "A third choice with a description."
            },
            {
              "value": "unsure",
              "label": "Not sure",
              "unsure": true
            }
          ],
          "kind": "factual"
        }
      ]
    },
    {
      "name": "checkbox",
      "questions": [
        {
          "id": "checkbox_demo",
          "type": "checkbox",
          "label": "Which constraints apply? (select all that apply)",
          "hint": "Pick everything that genuinely applies.",
          "options": [
            {
              "value": "time",
              "label": "Time",
              "description": "There is an external deadline."
            },
            {
              "value": "money",
              "label": "Money",
              "description": "Budget envelope is fixed."
            },
            {
              "value": "people",
              "label": "People",
              "description": "Headcount is fixed."
            },
            {
              "value": "compliance",
              "label": "Compliance",
              "description": "Legal or policy requirement."
            },
            {
              "value": "none",
              "label": "None of these",
              "unsure": true
            }
          ]
        }
      ]
    },
    {
      "name": "text",
      "questions": [
        {
          "id": "text_demo",
          "type": "text",
          "label": "What is the project name or short identifier?",
          "hint": "Single-line free text — short identifiers, names, follow-up values.",
          "placeholder": "e.g., project-alpha or Q3 analytics spike",
          "required": true
        }
      ]
    },
    {
      "name": "textarea",
      "questions": [
        {
          "id": "textarea_demo",
          "type": "textarea",
          "label": "In one sentence, what is the actual question you need answered?",
          "hint": "Multi-line. Auto-grows. Cap: 2 per form.",
          "placeholder": "e.g., Should we adopt Postgres for the analytics path?",
          "required": true,
          "maxLength": 240
        }
      ]
    },
    {
      "name": "scale",
      "questions": [
        {
          "id": "scale_demo",
          "type": "scale",
          "label": "How much capital is at risk?",
          "hint": "Five-button scale. Trade-off anchors, not good/bad.",
          "default": 2,
          "labels": [
            "None",
            "Minor",
            "Moderate",
            "Major",
            "Existential"
          ]
        }
      ]
    },
    {
      "name": "slider",
      "questions": [
        {
          "id": "slider_demo",
          "type": "slider",
          "label": "Estimated effort for this project",
          "hint": "Drag the handle. Nearest anchor label is highlighted.",
          "min": 0,
          "max": 100,
          "step": 10,
          "default": 30,
          "anchors": [
            {
              "at": 0,
              "label": "Trivial"
            },
            {
              "at": 50,
              "label": "Moderate"
            },
            {
              "at": 100,
              "label": "Heroic"
            }
          ]
        }
      ]
    },
    {
      "name": "segmented",
      "questions": [
        {
          "id": "segmented_demo",
          "type": "segmented",
          "label": "How will this decision be made?",
          "hint": "Pill-button toggle. 2–5 mutually-exclusive options.",
          "default": "consulted",
          "options": [
            {
              "value": "solo",
              "label": "Solo"
            },
            {
              "value": "consulted",
              "label": "Consulted"
            },
            {
              "value": "consensus",
              "label": "Consensus"
            }
          ]
        }
      ]
    },
    {
      "name": "priority-rank",
      "questions": [
        {
          "id": "priority_rank_demo",
          "type": "priority-rank",
          "label": "Order these factors from most to least weight",
          "hint": "Drag rows or use the ↑↓ buttons. Top position = highest weight.",
          "options": [
            {
              "value": "impact",
              "label": "Expected impact",
              "description": "How much does this move the needle?"
            },
            {
              "value": "risk",
              "label": "Downside risk",
              "description": "How bad is the worst case?"
            },
            {
              "value": "speed",
              "label": "Time to execute",
              "description": "How long before you see results?"
            },
            {
              "value": "reversibility",
              "label": "Reversibility",
              "description": "Can you undo it if you're wrong?"
            }
          ]
        }
      ]
    },
    {
      "name": "file-upload",
      "questions": [
        {
          "id": "file_upload_demo",
          "type": "file-upload",
          "label": "Attach a supporting document (optional)",
          "hint": "Drag-and-drop or click to browse. Embeds as base64 in the export.",
          "accept": "image/*,application/pdf,text/plain",
          "maxSizeKb": 512,
          "commentary": false
        }
      ]
    },
    {
      "name": "narrative-card",
      "questions": [
        {
          "id": "narrative_card_demo",
          "type": "narrative-card",
          "icon": "⚖️",
          "title": "Now for the stakes.",
          "body": "Understanding what is on the line shapes the recommendation you will get back. The next questions help calibrate how to weight competing concerns."
        }
      ]
    },
    {
      "name": "embedded-media",
      "questions": [
        {
          "id": "embedded_media_demo",
          "type": "embedded-media",
          "src": "data:image/svg+xml;utf8,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20320%20180%22%20width=%22320%22%20height=%22180%22%20role=%22img%22%3E%20%3Crect%20width=%22320%22%20height=%22180%22%20fill=%22%23f7f8fa%22/%3E%20%3Cg%20stroke=%22%23d8dce3%22%20stroke-width=%221%22%3E%20%3Cline%20x1=%2240%22%20y1=%2220%22%20x2=%2240%22%20y2=%22150%22/%3E%3Cline%20x1=%2240%22%20y1=%22150%22%20x2=%22300%22%20y2=%22150%22/%3E%20%3Cline%20x1=%2240%22%20y1=%22115%22%20x2=%22300%22%20y2=%22115%22%20stroke-dasharray=%223%203%22/%3E%20%3Cline%20x1=%2240%22%20y1=%2280%22%20x2=%22300%22%20y2=%2280%22%20stroke-dasharray=%223%203%22/%3E%20%3Cline%20x1=%2240%22%20y1=%2245%22%20x2=%22300%22%20y2=%2245%22%20stroke-dasharray=%223%203%22/%3E%20%3C/g%3E%20%3Cpolyline%20fill=%22none%22%20stroke=%22%232f6df6%22%20stroke-width=%222.5%22%20stroke-linejoin=%22round%22%20points=%2240,132%2092,108%20144,118%20196,74%20248,58%20300,36%22/%3E%20%3Cg%20fill=%22%232f6df6%22%3E%20%3Ccircle%20cx=%2240%22%20cy=%22132%22%20r=%223%22/%3E%3Ccircle%20cx=%2292%22%20cy=%22108%22%20r=%223%22/%3E%3Ccircle%20cx=%22144%22%20cy=%22118%22%20r=%223%22/%3E%20%3Ccircle%20cx=%22196%22%20cy=%2274%22%20r=%223%22/%3E%3Ccircle%20cx=%22248%22%20cy=%2258%22%20r=%223%22/%3E%3Ccircle%20cx=%22300%22%20cy=%2236%22%20r=%223%22/%3E%20%3C/g%3E%20%3Cg%20font-family=%22system-ui,sans-serif%22%20font-size=%229%22%20fill=%22%236b7280%22%3E%20%3Ctext%20x=%2236%22%20y=%22164%22%20text-anchor=%22middle%22%3EQ1%3C/text%3E%3Ctext%20x=%2288%22%20y=%22164%22%20text-anchor=%22middle%22%3EQ2%3C/text%3E%20%3Ctext%20x=%22140%22%20y=%22164%22%20text-anchor=%22middle%22%3EQ3%3C/text%3E%3Ctext%20x=%22192%22%20y=%22164%22%20text-anchor=%22middle%22%3EQ4%3C/text%3E%20%3Ctext%20x=%22244%22%20y=%22164%22%20text-anchor=%22middle%22%3EQ5%3C/text%3E%3Ctext%20x=%22296%22%20y=%22164%22%20text-anchor=%22middle%22%3EQ6%3C/text%3E%20%3Ctext%20x=%2234%22%20y=%22153%22%20text-anchor=%22end%22%3E0%3C/text%3E%3Ctext%20x=%2234%22%20y=%22118%22%20text-anchor=%22end%22%3E25%3C/text%3E%20%3Ctext%20x=%2234%22%20y=%2283%22%20text-anchor=%22end%22%3E50%3C/text%3E%3Ctext%20x=%2234%22%20y=%2248%22%20text-anchor=%22end%22%3E75%3C/text%3E%20%3C/g%3E%20%3Ctext%20x=%2240%22%20y=%2214%22%20font-family=%22system-ui,sans-serif%22%20font-size=%2210%22%20font-weight=%22600%22%20fill=%22%23374151%22%3EAdoption%20by%20quarter%20(illustrative)%3C/text%3E%20%3C/svg%3E",
          "alt": "Illustrative line chart: adoption rising from Q1 to Q6",
          "caption": "Example embedded image — reference artifact for the decision. Inlined as an SVG data URI so the form renders with no network access."
        }
      ]
    },
    {
      "name": "multi-branch",
      "questions": [
        {
          "id": "multi_branch_demo",
          "type": "radio",
          "label": "What format do you need for the output?",
          "hint": "Selecting an option reveals a follow-up question specific to that choice.",
          "required": true,
          "options": [
            {
              "value": "report",
              "label": "Report",
              "description": "A written document with findings and recommendations.",
              "branch": {
                "id": "report_pages",
                "type": "slider",
                "label": "How many pages should the report be?",
                "min": 1,
                "max": 50,
                "default": 10
              }
            },
            {
              "value": "dashboard",
              "label": "Dashboard",
              "description": "An interactive visualization of the data.",
              "branch": {
                "id": "dashboard_refresh",
                "type": "segmented",
                "label": "Refresh cadence",
                "options": [
                  {
                    "value": "live",
                    "label": "Live"
                  },
                  {
                    "value": "daily",
                    "label": "Daily"
                  },
                  {
                    "value": "weekly",
                    "label": "Weekly"
                  }
                ]
              }
            },
            {
              "value": "slides",
              "label": "Slides",
              "description": "A presentation deck.",
              "branch": {
                "id": "slides_audience",
                "type": "text",
                "label": "Who is the primary audience?",
                "placeholder": "e.g., exec team, engineering leads"
              }
            },
            {
              "value": "unsure",
              "label": "Not sure yet",
              "unsure": true
            }
          ],
          "kind": "factual"
        }
      ]
    }
  ],
  "knownContext": [],
  "routing": {},
  "theme": {
    "preset": "default"
  },
  "sources": [
    {
      "url": "https://design-system.service.gov.uk/patterns/question-pages/",
      "label": "GOV.UK question pages",
      "note": "one thing per page"
    },
    {
      "url": "https://www.w3.org/WAI/ARIA/apg/patterns/radio/",
      "label": "WAI-ARIA radio group pattern"
    }
  ]
}
